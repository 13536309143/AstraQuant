LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_WEB_SEARCH=true
AGENT_CONCURRENCY=2
PORT=8787
LLM_TIMEOUT_MS=180000

